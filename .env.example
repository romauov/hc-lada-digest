# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Модели OpenRouter (по умолчанию gpt-4o-mini для анализа, gpt-4o для дайджеста)
# При ошибке основной модели автоматический fallback на qwen/qwen2.5-72b-instruct
LLM_LITE_MODEL=openai/gpt-4o-mini
LLM_PRO_MODEL=openai/gpt-4o
LLM_SEARCH_MODEL=perplexity/sonar
LLM_FALLBACK_MODEL=qwen/qwen2.5-72b-instruct

# Включить LLM-анализ (false = итерация 1, простой дайджест)
USE_LLM=true

# Локальное хранилище (путь внутри контейнера, DATA_DIR=/data в docker-compose)
DATA_DIR=/data

# Telegram
TG_BOT_TOKEN=your_bot_token
TG_CHAT_ID=your_channel_or_chat_id
TG_ADMIN_ID=your_personal_chat_id   # для уведомлений об ошибках

# Настройки пайплайна
FRESHNESS_HOURS=24
MAX_NEWS_IN_DIGEST=20

# Ручное подтверждение изменений графа через Telegram (inline-кнопки ✅/❌)
# Запрос приходит в 9:00, нерешённые пересылаются раз в час до 18:00 (по дедлайну = отклонено)
GRAPH_APPROVAL=true
GRAPH_APPROVAL_END_HOUR=18            # час дедлайна
GRAPH_APPROVAL_REMIND_INTERVAL=3600   # сек между напоминаниями

# Yandex Search API (опционально, для поиска новостей)
YANDEX_SEARCH_USER=
YANDEX_SEARCH_KEY=

# ML service (семантическая дедупликация и фильтр релевантности)
ML_URL=http://ml:8001                  # пусто → ML отключён
DEDUP_THRESHOLD=0.92
RELEVANCE_THRESHOLD=0.65
EMBED_MODEL=cointegrated/rubert-tiny2
